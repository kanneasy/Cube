# Environment variables. Copy what you need into a local .env (gitignored).
# Real secrets go in .env, NEVER in this tracked example file.

# --- Database ---
# Leave DATABASE_URL UNSET for local dev: the app uses PGlite (an embedded
# Postgres in ./data/pg) automatically — free, no server.
# For production, set it to your Supabase "Connection Pooling" (Transaction)
# string (host ...pooler.supabase.com, port 6543). The pooler is required for
# serverless. Use an alphanumeric DB password (?, !, @ break a postgres:// URL).
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Supabase Auth (only once the app adds auth and is ported to production) ---
# Frontend (safe to expose; Vite inlines VITE_* into the client bundle):
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public key>
# Backend verifies tokens against the project's public JWKS (ES256) — no JWT
# secret is needed. The service-role key, if used, is for local seeding only.
