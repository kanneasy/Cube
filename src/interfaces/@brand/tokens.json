{
  "$description": "The machine half of the brand spec (W3C DTCG format). The prose in colors.md/typography.md/visual.md is the human truth; this file is its compiled form. The design expert's exact values land here verbatim, then `node ~/builder/bin/build-tokens.mjs .` regenerates dist/web/tokens.css. Dark-mode values go in $extensions[\"builder.dark\"]. These placeholder values are a neutral monochrome starter — the spec phase replaces them with the app's real system.",
  "color": {
    "surface": { "$type": "color", "$value": "#fafaf9", "$extensions": { "builder.dark": "#151312" } },
    "raised": { "$type": "color", "$value": "#ffffff", "$extensions": { "builder.dark": "#201d1b" } },
    "ink": { "$type": "color", "$value": "#1c1917", "$extensions": { "builder.dark": "#f4f2f0" } },
    "muted": { "$type": "color", "$value": "#78716c", "$extensions": { "builder.dark": "#a8a29e" } },
    "line": { "$type": "color", "$value": "#e7e5e4", "$extensions": { "builder.dark": "#37332f" } },
    "accent": { "$type": "color", "$value": "#1c1917", "$extensions": { "builder.dark": "#f4f2f0" } },
    "on-accent": { "$type": "color", "$value": "#ffffff", "$extensions": { "builder.dark": "#151312" } },
    "danger": { "$type": "color", "$value": "#b91c1c", "$extensions": { "builder.dark": "#f87171" } },
    "focus": { "$type": "color", "$value": "#1c1917", "$extensions": { "builder.dark": "#f4f2f0" } }
  },
  "type": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["ui-sans-serif", "system-ui", "sans-serif"] },
      "body": { "$type": "fontFamily", "$value": ["ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "monospace"] }
    },
    "weight": {
      "display": { "$type": "fontWeight", "$value": 600 },
      "body": { "$type": "fontWeight", "$value": 400 }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "clamp(1.75rem, 1.5rem + 1.2vw, 2.25rem)" },
      "title": { "$type": "dimension", "$value": "1.25rem" },
      "body": { "$type": "dimension", "$value": "1rem" },
      "small": { "$type": "dimension", "$value": "0.875rem" }
    },
    "leading": {
      "body": { "$type": "number", "$value": 1.5 },
      "display": { "$type": "number", "$value": 1.15 }
    }
  },
  "space": {
    "4": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "12": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "16": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "24": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "32": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "48": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
    "64": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "card": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } }
  },
  "elevation": {
    "card": { "$type": "shadow", "$value": "0 1px 2px rgba(28, 25, 23, 0.06)", "$extensions": { "builder.dark": "0 1px 2px rgba(0, 0, 0, 0.4)" } },
    "raised": { "$type": "shadow", "$value": "0 8px 32px rgba(28, 25, 23, 0.14)", "$extensions": { "builder.dark": "0 8px 32px rgba(0, 0, 0, 0.55)" } }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": { "value": 150, "unit": "ms" } },
      "base": { "$type": "duration", "$value": { "value": 250, "unit": "ms" } }
    },
    "easing": {
      "settle": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] }
    }
  }
}
